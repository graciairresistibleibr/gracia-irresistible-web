---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/ui/Section.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Accordion from '../../components/ui/Accordion.astro';
import Divider from '../../components/ui/Divider.astro';
import Button from '../../components/ui/Button.astro';

const faqs = [
  {
    q: '¿Cómo me hago miembro?',
    a: 'Participá de la vida de la iglesia y conversá con un anciano. Después hay una clase de membresía y la recepción ante la congregación.',
  },
  {
    q: '¿Qué implica ser miembro?',
    a: 'La iglesia se compromete a amarte, enseñarte y cuidarte. Vos, a congregarte, servir con tus dones y vivir en santidad.',
  },
  {
    q: '¿Qué es la disciplina restauradora?',
    a: 'Es el cuidado de la iglesia cuando un miembro persiste en pecado. Según Mateo 18, busca restaurar, no castigar.',
  },
  {
    q: '¿Puedo participar sin ser miembro?',
    a: 'Sí. Todos son bienvenidos a los cultos y estudios, sin necesidad de ser miembros.',
  },
];
---

<Layout
  title="Membresía"
  description="Qué es la membresía significativa en la Iglesia Bautista Reformada Gracia Irresistible y cómo integrarte."
>
  <PageHero
    eyebrow="Membresía"
    title="Un compromiso mutuo, no un trámite"
    subtitle="Ser miembro es pertenecer a un pueblo que se ama, se enseña y se cuida en Cristo."
    image="oracion"
  />

  <Section surface="marfil" space="md" contain="reading">
    <div class="prose">
      <p>
        En la Biblia no existe el creyente aislado: Cristo nos salva y nos une a su iglesia. Ser miembro es hacer visible ese compromiso con una congregación local.
      </p>
      <p>
        No da un estatus especial: es un lugar para crecer, servir y ser cuidado por los ancianos.
      </p>
    </div>

    <Divider variant="diamond-line" />

    <h2 class="t-h2">Preguntas frecuentes</h2>
    <div class="faq mt-6">
      {faqs.map((f) => <Accordion summary={f.q}><p>{f.a}</p></Accordion>)}
    </div>

    <div class="cta mt-8">
      <p class="t-body-lg">¿Querés dar el paso o conversar con un anciano?</p>
      <Button variant="primary" href="/contacto" class="mt-4">Escribinos</Button>
    </div>
  </Section>
</Layout>

<style>
  .mt-6 { margin-top: var(--space-6); }
  .mt-8 { margin-top: var(--space-8); }
  .mt-4 { margin-top: var(--space-4); }
  .faq {
    border-top: 1px solid var(--border-subtle);
  }
  .cta {
    text-align: center;
    padding-top: var(--space-8);
  }
</style>
