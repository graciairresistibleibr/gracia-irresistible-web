---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import HubCard from '../../components/ui/HubCard.astro';
import Divider from '../../components/ui/Divider.astro';

const subpaginas = [
  {
    href: '/somos/historia',
    titulo: 'Nuestra historia',
    texto: 'Cómo nació esta congregación y por qué existimos.',
  },
  {
    href: '/somos/mision-y-vision',
    titulo: 'Misión y visión',
    texto: 'Para qué existimos y hacia dónde vamos.',
  },
  {
    href: '/somos/liderazgo',
    titulo: 'Liderazgo',
    texto: 'Quienes pastorean y sirven a la iglesia.',
  },
  {
    href: '/somos/membresia',
    titulo: 'Membresía',
    texto: 'Qué significa ser miembro y cómo integrarte.',
  },
];
---

<Layout
  title="Somos"
  description="Quiénes somos: una iglesia bautista reformada y confesional en Resistencia, Chaco."
>
  <PageHero
    eyebrow="Quiénes somos"
    title="Una congregación local, confesional y reformada"
    subtitle="La iglesia no es un lugar. Es un pueblo que Cristo compró con su sangre."
    image="oracion"
  />

  <Section surface="marfil" space="md" contain="reading">
    <p class="t-body-lg measure">
      Somos una iglesia bautista reformada en Resistencia, Chaco, que confiesa la Confesión de Londres de 1689.
    </p>
    <p class="t-body mt-6">
      La salud de una iglesia no se mide por su tamaño, sino por su fidelidad a la Escritura: predicación expositiva, adoración bíblica y cuidado mutuo.
    </p>
    <Divider variant="diamond-line" />
    <p class="t-body">
      Conocenos un poco más, y sobre todo, visitanos un domingo.
    </p>
  </Section>

  <Section surface="crema" space="md">
    <Container>
      <div class="hub-grid">
        {subpaginas.map((p) => <HubCard href={p.href} titulo={p.titulo}>{p.texto}</HubCard>)}
      </div>
    </Container>
  </Section>
</Layout>

<style>
  .mt-6 { margin-top: var(--space-6); }
  .hub-grid {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 720px) {
    .hub-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
