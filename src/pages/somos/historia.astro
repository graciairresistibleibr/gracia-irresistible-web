---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Divider from '../../components/ui/Divider.astro';
import PhotoBand from '../../components/ui/PhotoBand.astro';
import Verse from '../../components/ui/Verse.astro';
import Link from '../../components/ui/Link.astro';
import { getEntry, render } from 'astro:content';

// El texto de esta página se edita desde el panel (/admin → «Páginas»).
const pagina = (await getEntry('paginas', 'historia'))!;
const d = pagina.data;
const { Content } = await render(pagina);
---

<Layout
  title={d.antetitulo}
  description={d.descripcion}
>
  <Section surface="marfil" space="sm" contain="reading">
    <Eyebrow>{d.antetitulo}</Eyebrow>
    <h1 class="t-h1 mt-3">{d.titulo}</h1>
    <p class="t-body-lg mt-4 measure">{d.introduccion}</p>
  </Section>

  {d.versiculo && (
    <PhotoBand image="congregacion" align="center" space="md" contain="reading">
      <Verse reference={d.referencia ?? ''} accent="oro" color="var(--color-crema)">
        {d.versiculo}
      </Verse>
    </PhotoBand>
  )}

  <Section surface="marfil" space="md" contain="reading">
    <div class="prose">
      <Content />
    </div>

    <Divider variant="diamond-line" />

    <p class="t-body">
      Conocé también <Link href="/somos/mision-y-vision">nuestra misión y visión</Link>
      o <Link href="/somos/liderazgo">quiénes sirven como ancianos y diáconos</Link>.
    </p>
  </Section>
</Layout>

<style>
  .mt-3 { margin-top: var(--space-3); }
  .mt-4 { margin-top: var(--space-4); }
</style>
