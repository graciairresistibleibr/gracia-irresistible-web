---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import TulipPoint from '../../components/creemos/TulipPoint.astro';

const puntos = [
  {
    inicial: 'T',
    titulo: 'Depravación total',
    subtitulo: 'Total depravity',
    texto:
      'El pecado afecta todo nuestro ser. Muertos en pecado, no podemos buscar a Dios por nosotros mismos.',
  },
  {
    inicial: 'U',
    titulo: 'Elección incondicional',
    subtitulo: 'Unconditional election',
    texto:
      'Dios eligió a los suyos antes de la creación, no por mérito de ellos, sino por pura gracia.',
  },
  {
    inicial: 'L',
    titulo: 'Redención particular',
    subtitulo: 'Limited atonement',
    texto:
      'Cristo dio su vida por su pueblo y realmente lo salvó. Su muerte no hace posible la salvación: la asegura.',
  },
  {
    inicial: 'I',
    titulo: 'Gracia irresistible',
    subtitulo: 'Irresistible grace',
    highlight: true,
    texto:
      'Cuando Dios llama, su gracia da un corazón nuevo que quiere venir a Cristo. De esta verdad toma su nombre nuestra iglesia.',
  },
  {
    inicial: 'P',
    titulo: 'Perseverancia de los santos',
    subtitulo: 'Perseverance of the saints',
    texto:
      'Dios guarda a los suyos hasta el fin y completa la obra que comenzó. Ninguno se pierde.',
  },
];
---

<Layout
  title="Las doctrinas de la gracia"
  description="Las doctrinas de la gracia (TULIP): la salvación es obra soberana de Dios de principio a fin."
>
  <PageHero
    eyebrow="Nuestra confesión"
    title="Las doctrinas de la gracia"
    subtitle="La salvación es del Señor, de principio a fin. Cinco verdades, resumidas en el acróstico TULIP."
    image="manos-biblia"
  />

  <Section surface="marfil" space="md" contain="default">
    <p class="intro measure">
      Cinco verdades bíblicas sobre cómo salva Dios. No son un sistema frío, sino motivo de adoración.
    </p>

    <div class="tulip-stack">
      {puntos.map((p) => (
        <TulipPoint
          inicial={p.inicial}
          titulo={p.titulo}
          subtitulo={p.subtitulo}
          highlight={p.highlight}
          id={p.highlight ? 'gracia-irresistible' : undefined}
        >
          {p.texto}
        </TulipPoint>
      ))}
    </div>
  </Section>
</Layout>

<style>
  .intro {
    max-width: 64ch;
    margin-inline: auto;
    margin-bottom: var(--space-12);
    color: var(--color-piedra-texto);
    text-align: center;
  }
  .tulip-stack {
    max-width: 940px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
</style>
