---
/**
 * Valor fundamental: número grande (Lora, oro antiguo) + título + descripción.
 */
interface Props {
  numero: number | string;
  titulo: string;
  class?: string;
}
const { numero, titulo, class: className } = Astro.props;
const n = typeof numero === 'number' ? String(numero).padStart(2, '0') : numero;
---

<article class:list={['value', className]}>
  <span class="value__num" aria-hidden="true">{n}</span>
  <h3 class="t-h3 value__title">{titulo}</h3>
  <p class="value__desc"><slot /></p>
</article>

<style>
  .value {
    position: relative;
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-4);
  }
  .value::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--color-oro-antiguo);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .value:hover::before {
    transform: scaleX(1);
  }
  .value__num {
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .value:hover .value__num {
    transform: translateX(4px);
  }
  .value__num {
    font-family: var(--font-serif);
    font-size: 2rem;
    line-height: 1;
    color: var(--color-oro-texto);
    display: block;
    margin-bottom: var(--space-3);
  }
  .value__title {
    margin-bottom: var(--space-2);
  }
  .value__desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-piedra-texto);
  }
</style>
