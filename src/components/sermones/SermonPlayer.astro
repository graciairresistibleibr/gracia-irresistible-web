---
/**
 * Reproductor de sermón sobrio basado en <audio> nativo (accesible, sin
 * librerías). Debajo: descargar audio, descargar notas y copiar enlace.
 */
import Icon from '../ui/Icon.astro';
interface Props {
  audioUrl: string;
  titulo: string;
  pdfNotas?: string;
  class?: string;
}
const { audioUrl, titulo, pdfNotas, class: className } = Astro.props;
---

<div class:list={['player', className]}>
  <audio
    class="player__audio"
    controls
    preload="none"
    aria-label={`Reproductor de audio: ${titulo}`}
  >
    <source src={audioUrl} type="audio/mpeg" />
    Tu navegador no puede reproducir el audio.
    <a href={audioUrl}>Descargá el archivo</a>.
  </audio>

  <div class="player__actions">
    <a class="player__btn" href={audioUrl} download>
      <Icon name="download" size={16} /> Descargar audio
    </a>
    {pdfNotas && (
      <a class="player__btn" href={pdfNotas} download>
        <Icon name="file-text" size={16} /> Descargar notas (PDF)
      </a>
    )}
    <button class="player__btn" type="button" data-copy-link>
      <Icon name="link" size={16} /> <span data-copy-label>Copiar enlace</span>
    </button>
  </div>
</div>

<style>
  .player {
    background: var(--color-crema);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    padding: var(--space-6);
  }
  .player__audio {
    width: 100%;
    height: 42px;
  }
  .player__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-stone);
  }
  .player__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-sepia);
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: none;
  }
  .player__btn:hover,
  .player__btn:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
    color: var(--color-sepia-profundo);
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  const label = btn?.querySelector<HTMLElement>('[data-copy-label]');
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      if (label) {
        const prev = label.textContent;
        label.textContent = 'Enlace copiado';
        setTimeout(() => (label.textContent = prev), 2000);
      }
    } catch {
      /* Sin portapapeles: no hacemos nada intrusivo. */
    }
  });
</script>
