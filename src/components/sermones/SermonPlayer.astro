---
/**
 * Reproductor de sermón sobrio. Muestra, según lo que tenga cargado el sermón:
 * video de YouTube (modo sin cookies), audio con <audio> nativo y enlace a
 * Spotify. Debajo: descargar audio, descargar notas y copiar enlace.
 */
import Icon from '../ui/Icon.astro';
import { youtubeId } from '../../utils/format.ts';
interface Props {
  audioUrl?: string;
  youtubeUrl?: string;
  spotifyUrl?: string;
  titulo: string;
  pdfNotas?: string;
  class?: string;
}
const { audioUrl, youtubeUrl, spotifyUrl, titulo, pdfNotas, class: className } = Astro.props;
const videoId = youtubeUrl ? youtubeId(youtubeUrl) : undefined;
---

<div class:list={['player', className]}>
  {videoId && (
    <div class="player__video">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${videoId}?rel=0`}
        title={`Video: ${titulo}`}
        loading="lazy"
        allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
  )}

  {audioUrl && (
    <audio
      class:list={['player__audio', videoId && 'player__audio--after']}
      controls
      preload="none"
      aria-label={`Reproductor de audio: ${titulo}`}
    >
      <source src={audioUrl} type="audio/mpeg" />
      Tu navegador no puede reproducir el audio.
      <a href={audioUrl}>Descargá el archivo</a>.
    </audio>
  )}

  <div class="player__actions">
    {audioUrl && (
      <a class="player__btn" href={audioUrl} download>
        <Icon name="download" size={16} /> Descargar audio
      </a>
    )}
    {spotifyUrl && (
      <a class="player__btn" href={spotifyUrl} target="_blank" rel="noopener noreferrer">
        <Icon name="play" size={16} /> Escuchar en Spotify
      </a>
    )}
    {youtubeUrl && !videoId && (
      <a class="player__btn" href={youtubeUrl} target="_blank" rel="noopener noreferrer">
        <Icon name="play" size={16} /> Ver en YouTube
      </a>
    )}
    {pdfNotas && (
      <a class="player__btn" href={pdfNotas} download>
        <Icon name="file-text" size={16} /> Descargar notas (PDF)
      </a>
    )}
    <button class="player__btn" type="button" data-copy-link>
      <Icon name="link" size={16} /> <span data-copy-label>Copiar enlace</span>
    </button>
  </div>
</div>

<style>
  .player {
    background: var(--color-crema);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    padding: var(--space-6);
  }
  .player__video {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--color-sepia-profundo);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .player__video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .player__audio {
    width: 100%;
    height: 42px;
  }
  .player__audio--after {
    margin-top: var(--space-4);
  }
  .player__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-stone);
  }
  .player__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-sepia);
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: none;
  }
  .player__btn:hover,
  .player__btn:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
    color: var(--color-sepia-profundo);
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  const label = btn?.querySelector<HTMLElement>('[data-copy-label]');
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      if (label) {
        const prev = label.textContent;
        label.textContent = 'Enlace copiado';
        setTimeout(() => (label.textContent = prev), 2000);
      }
    } catch {
      /* Sin portapapeles: no hacemos nada intrusivo. */
    }
  });
</script>
