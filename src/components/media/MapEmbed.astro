---
/**
 * Mapa de Google con el pin en la dirección de la iglesia. Carga diferida.
 * «Cómo llegar» abre el enlace de Google Maps cargado en el panel
 * (Datos de la iglesia → Dirección → Enlace de Google Maps).
 */
interface Props {
  lat: number;
  lng: number;
  mapsUrl?: string;
  label?: string;
  zoom?: number;
  class?: string;
}
const { lat, lng, mapsUrl, label = 'Ubicación de la iglesia', zoom = 16, class: className } =
  Astro.props;
const src = `https://www.google.com/maps?q=${lat},${lng}&z=${zoom}&hl=es&output=embed`;
const comoLlegarUrl =
  mapsUrl || `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`;
---

<figure class:list={['map', className]}>
  <iframe
    class="map__frame"
    title={label}
    src={src}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>
  <figcaption class="map__caption">
    <a href={comoLlegarUrl} target="_blank" rel="noopener noreferrer">Cómo llegar (Google Maps)</a>
  </figcaption>
</figure>

<style>
  .map {
    margin: 0;
  }
  .map__frame {
    width: 100%;
    height: 340px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    display: block;
  }
  .map__caption {
    display: flex;
    gap: 0.6rem;
    margin-top: var(--space-3);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
  }
  .map__caption a {
    color: var(--color-sepia);
    text-underline-offset: 3px;
  }
</style>
