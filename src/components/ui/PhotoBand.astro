---
/**
 * Franja a todo el ancho con FOTO de fondo + capa marrón (sepia) al 70% y leve
 * difuminado. Texto claro por encima. Para banners fotográficos entre secciones.
 */
import Container from './Container.astro';
interface Props {
  image: string; // nombre base en /images (sin extensión)
  overlay?: number; // opacidad de la capa marrón (0–1)
  space?: 'sm' | 'md' | 'lg';
  align?: 'left' | 'center';
  contain?: 'default' | 'reading' | 'wide';
  minHeight?: string;
  class?: string;
}
const {
  image,
  overlay = 0.7,
  space = 'md',
  align = 'left',
  contain = 'default',
  minHeight,
  class: className,
} = Astro.props;
---

<section
  class:list={['band', `band--${space}`, `band--${align}`, className]}
  style={`--band-overlay:${overlay}; ${minHeight ? `--band-min:${minHeight};` : ''}`}
>
  <div class="band__bg" aria-hidden="true">
    <picture>
      <source srcset={`/images/${image}.webp`} type="image/webp" />
      <img src={`/images/${image}.jpg`} alt="" loading="lazy" decoding="async" />
    </picture>
  </div>
  <div class="band__overlay" aria-hidden="true"></div>
  <Container width={contain}>
    <div class="band__inner"><slot /></div>
  </Container>
</section>

<style>
  .band {
    position: relative;
    overflow: hidden;
    background: var(--color-sepia-profundo);
    color: var(--color-crema);
    display: flex;
    align-items: center;
    min-height: var(--band-min, auto);
  }
  .band--sm { padding-block: clamp(3rem, 7vw, 4.5rem); }
  .band--md { padding-block: clamp(4rem, 9vw, 7rem); }
  .band--lg { padding-block: clamp(5rem, 12vw, 9rem); }
  .band__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .band__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) blur(2px);
    transform: scale(1.06);
  }
  .band__overlay {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: rgba(74, 46, 23, var(--band-overlay));
  }
  .band > :global(.container) {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  .band--center .band__inner {
    text-align: center;
    max-width: 60ch;
    margin-inline: auto;
  }
  .band--left .band__inner {
    max-width: 56ch;
  }
</style>
