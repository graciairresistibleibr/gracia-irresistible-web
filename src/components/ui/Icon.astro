---
/**
 * Íconos monocromos estilo Lucide (trazo fino, geométrico, sin relleno).
 * Inline SVG para mantener cero JS y no depender de una librería externa.
 * Añadir nuevos íconos al mapa `paths` con el mismo estilo (stroke, 24x24).
 */
interface Props {
  name: keyof typeof paths;
  size?: number;
  class?: string;
  title?: string;
}
const { name, size = 22, class: className, title } = Astro.props;

const paths = {
  menu: '<line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/>',
  x: '<line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/>',
  'arrow-right': '<line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/>',
  'chevron-down': '<polyline points="6 9 12 15 18 9"/>',
  'chevron-right': '<polyline points="9 6 15 12 9 18"/>',
  play: '<polygon points="7 5 19 12 7 19 7 5"/>',
  download: '<path d="M12 3v12"/><polyline points="7 10 12 15 17 10"/><path d="M5 21h14"/>',
  'map-pin':
    '<path d="M20 10c0 5.5-8 11-8 11s-8-5.5-8-11a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="1"/><polyline points="3 7 12 13 21 7"/>',
  phone:
    '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A15 15 0 0 1 4 5a1 1 0 0 1 1-1Z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/>',
  calendar:
    '<rect x="4" y="5" width="16" height="16" rx="1"/><line x1="4" y1="9" x2="20" y2="9"/><line x1="9" y1="3" x2="9" y2="6"/><line x1="15" y1="3" x2="15" y2="6"/>',
  search: '<circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/>',
  copy: '<rect x="9" y="9" width="12" height="12" rx="1"/><path d="M5 15V5a1 1 0 0 1 1-1h10"/>',
  link: '<path d="M9 15l6-6"/><path d="M11 6l1-1a4 4 0 0 1 6 6l-1 1"/><path d="M13 18l-1 1a4 4 0 0 1-6-6l1-1"/>',
  check: '<polyline points="4 12 10 18 20 5"/>',
  'file-text':
    '<path d="M6 3h8l4 4v14a0 0 0 0 1 0 0H6a0 0 0 0 1 0 0V3Z"/><polyline points="14 3 14 7 18 7"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="15" y2="16"/>',
  book: '<path d="M4 5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2Z"/><line x1="8" y1="7" x2="14" y2="7"/>',
  users:
    '<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="M16 6a3 3 0 0 1 0 6"/><path d="M18 20a6 6 0 0 0-3-5"/>',
  youtube:
    '<rect x="3" y="6" width="18" height="12" rx="3"/><polygon points="10 9 15 12 10 15 10 9"/>',
  facebook:
    '<path d="M14 8h2V5h-2a3 3 0 0 0-3 3v2H9v3h2v6h3v-6h2l1-3h-3V8a1 1 0 0 1 1-1Z"/>',
  instagram:
    '<rect x="4" y="4" width="16" height="16" rx="4"/><circle cx="12" cy="12" r="3.2"/><circle cx="16.5" cy="7.5" r="0.6" fill="currentColor" stroke="none"/>',
  whatsapp:
    '<path d="M4 20l1.4-4A8 8 0 1 1 9 19.4L4 20Z"/><path d="M9 9c0 3 3 6 6 6 1 0 1.5-.5 1.5-1.2 0-.3-1.5-1-1.8-1.1-.3-.1-.5 0-.7.3-.2.3-.4.5-.6.5-.8 0-2.6-1.8-2.6-2.6 0-.2.2-.4.5-.6.3-.2.4-.4.3-.7C11.2 9 10.5 7.5 10.2 7.5 9.5 7.5 9 8 9 9Z"/>',
} as const;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={title ? 'img' : 'presentation'}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
>
  {title && <title>{title}</title>}
  <Fragment set:html={paths[name]} />
</svg>
