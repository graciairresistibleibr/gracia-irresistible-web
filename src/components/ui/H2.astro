---
/** Título de sección. Lora. */
interface Props {
  as?: keyof HTMLElementTagNameMap;
  color?: string;
  class?: string;
}
const { as = 'h2', color, class: className } = Astro.props;
const Tag = as;
---
<Tag class:list={['t-h2', className]} style={[color && `color:${color}`, 'text-wrap:balance'].filter(Boolean).join(';')}>
  <slot />
</Tag>
