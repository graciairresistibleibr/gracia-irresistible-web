---
/**
 * Galería «Nuestras reuniones»: culto del domingo (mosaico con una foto grande)
 * y oración y estudio de los miércoles. Textos y fotos en src/data/reuniones.json
 * (panel → «Galería de reuniones»).
 */
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { conWebp } from '../../utils/fotos.ts';
import reuniones from '../../data/reuniones.json';

const { antetitulo, titulo, texto, domingo, miercoles } = reuniones;
const fotos = (lista: { foto: string; descripcion?: string }[]) =>
  (lista ?? []).filter((f) => f.foto).map((f) => ({ ...conWebp(f.foto), alt: f.descripcion ?? '' }));
const fotosDomingo = fotos(domingo.fotos);
const fotosMiercoles = fotos(miercoles.fotos);
---

<Section surface="crema" space="md" id="reuniones">
  <div class="head">
    <Eyebrow>{antetitulo}</Eyebrow>
    <h2 class="t-h2 mt-2">{titulo}</h2>
    {texto && <p class="head__text">{texto}</p>}
  </div>

  <article class="reunion">
    <header class="reunion__head">
      <p class="t-eyebrow reunion__when">{domingo.cuando}</p>
      <h3 class="t-h3">{domingo.titulo}</h3>
      {domingo.texto && <p class="reunion__text">{domingo.texto}</p>}
    </header>
    <div class="mosaico">
      {fotosDomingo.map((f) => (
        <figure class="foto">
          <picture>
            {f.webp && <source srcset={f.webp} type="image/webp" />}
            <img class="photo-treatment" src={f.src} alt={f.alt} loading="lazy" decoding="async" />
          </picture>
          {f.alt && <figcaption class="foto__caption" aria-hidden="true">{f.alt}</figcaption>}
        </figure>
      ))}
    </div>
  </article>

  <article class="reunion reunion--split">
    <header class="reunion__head">
      <p class="t-eyebrow reunion__when">{miercoles.cuando}</p>
      <h3 class="t-h3">{miercoles.titulo}</h3>
      {miercoles.texto && <p class="reunion__text">{miercoles.texto}</p>}
    </header>
    <div class="par">
      {fotosMiercoles.map((f) => (
        <figure class="foto">
          <picture>
            {f.webp && <source srcset={f.webp} type="image/webp" />}
            <img class="photo-treatment" src={f.src} alt={f.alt} loading="lazy" decoding="async" />
          </picture>
          {f.alt && <figcaption class="foto__caption" aria-hidden="true">{f.alt}</figcaption>}
        </figure>
      ))}
    </div>
  </article>
</Section>

<style>
  .mt-2 { margin-top: var(--space-2); }
  .head {
    margin-bottom: var(--space-12);
  }
  .head h2 {
    max-width: 24ch;
  }
  .head__text {
    margin-top: var(--space-4);
    max-width: 56ch;
    color: var(--color-piedra-texto);
  }

  .reunion + .reunion {
    margin-top: var(--space-16);
    padding-top: var(--space-12);
    border-top: 1px solid var(--border-subtle);
  }
  .reunion__head {
    margin-bottom: var(--space-6);
    max-width: 52ch;
  }
  .reunion__when {
    color: var(--color-sepia);
    margin-bottom: var(--space-2);
  }
  .reunion__text {
    margin-top: var(--space-3);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-piedra-texto);
  }

  .foto {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-sepia-profundo);
    aspect-ratio: 4 / 3;
  }
  .foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Al pasar el cursor: acercamiento lento y la descripción de la foto */
  .foto__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--space-8) var(--space-4) var(--space-3);
    background: linear-gradient(to top, rgba(42, 26, 13, 0.85), transparent);
    color: var(--color-crema);
    font-size: 0.8125rem;
    line-height: 1.4;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s ease, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }
  @media (hover: hover) {
    .foto img {
      transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1), filter 0.6s ease;
    }
    .foto:hover img {
      transform: scale(1.05);
      filter: sepia(0.05) saturate(0.95);
    }
    .foto:hover .foto__caption {
      opacity: 1;
      transform: none;
    }
  }
  @media (hover: none) {
    .foto__caption {
      display: none;
    }
  }

  /* Domingo: la primera foto grande y las demás alrededor, en tamaño parejo */
  .mosaico {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(2, 1fr);
  }
  .mosaico .foto:first-child {
    grid-column: span 2;
  }
  @media (min-width: 900px) {
    .mosaico {
      grid-template-columns: repeat(4, 1fr);
    }
    .mosaico .foto:first-child {
      grid-row: span 2;
      aspect-ratio: auto;
    }
  }

  /* Miércoles: texto a un lado y dos fotos al otro */
  .par {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }
  @media (min-width: 900px) {
    .reunion--split {
      display: grid;
      grid-template-columns: 4fr 8fr;
      gap: clamp(2rem, 5vw, 4rem);
      align-items: center;
    }
    .reunion--split .reunion__head {
      margin-bottom: 0;
    }
  }
  /* En celulares las fotos se deslizan de costado, para no alargar la página */
  @media (max-width: 599px) {
    .mosaico,
    .par {
      display: flex;
      gap: var(--space-3);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: -1.5rem;
      padding-inline: 1.5rem;
      scrollbar-width: none;
    }
    .mosaico::-webkit-scrollbar,
    .par::-webkit-scrollbar {
      display: none;
    }
    .mosaico .foto,
    .par .foto {
      flex: 0 0 82%;
      scroll-snap-align: center;
    }
    .head {
      margin-bottom: var(--space-8);
    }
    .reunion + .reunion {
      margin-top: var(--space-8);
      padding-top: var(--space-8);
    }
  }

</style>
