---
/**
 * Emblema central de identidad: cruz + rayos + Biblia abierta.
 * Monocromo (currentColor). Trazo fino, geométrico, sin sombras ni degradados.
 * Se usa como marca de agua (ver <Watermark>) y dentro del sello.
 */
interface Props {
  class?: string;
  title?: string;
  decorative?: boolean;
}
const { class: className, title, decorative = true } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 100 100"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role={decorative ? 'presentation' : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={!decorative ? title : undefined}
>
  {!decorative && title && <title>{title}</title>}
  <g
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <!-- Rayos detrás de la cruz -->
    <line x1="50" y1="6" x2="50" y2="1" opacity="0.55" />
    <line x1="34" y1="10" x2="30" y2="4" opacity="0.55" />
    <line x1="66" y1="10" x2="70" y2="4" opacity="0.55" />
    <line x1="24" y1="20" x2="18" y2="15" opacity="0.55" />
    <line x1="76" y1="20" x2="82" y2="15" opacity="0.55" />
    <line x1="19" y1="33" x2="12" y2="30" opacity="0.55" />
    <line x1="81" y1="33" x2="88" y2="30" opacity="0.55" />
    <!-- Cruz -->
    <line x1="50" y1="12" x2="50" y2="62" />
    <line x1="37" y1="27" x2="63" y2="27" />
    <!-- Biblia abierta (dos páginas) -->
    <path d="M50 70 C 42 64, 30 64, 20 68 L 20 88 C 30 84, 42 84, 50 90 Z" />
    <path d="M50 70 C 58 64, 70 64, 80 68 L 80 88 C 70 84, 58 84, 50 90 Z" />
    <line x1="50" y1="70" x2="50" y2="90" />
    <!-- Líneas de texto insinuadas en las páginas -->
    <line x1="27" y1="73" x2="43" y2="72" stroke-width="0.9" opacity="0.6" />
    <line x1="27" y1="78" x2="43" y2="77" stroke-width="0.9" opacity="0.6" />
    <line x1="57" y1="72" x2="73" y2="73" stroke-width="0.9" opacity="0.6" />
    <line x1="57" y1="77" x2="73" y2="78" stroke-width="0.9" opacity="0.6" />
  </g>
</svg>
