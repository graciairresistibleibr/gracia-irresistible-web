---
/**
 * Layout base de todas las páginas. Incluye SEO (OG + Twitter Cards),
 * enlace de salto, cabecera y pie. Preload de los pesos tipográficos críticos.
 */
import '../styles/global.css';
import '../styles/motion.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { iglesia } from '../data/iglesia.ts';

interface Props {
  title: string;
  description?: string;
  /** Ruta de imagen OG específica (por defecto la portada de identidad). */
  ogImage?: string;
  /** Excluir de indexación. */
  noindex?: boolean;
  /** Contenido JSON-LD adicional (se suma a los datos de la iglesia). */
  schema?: object;
  /** Imagen principal de la página, para precargarla (mejora la velocidad). */
  preloadImage?: string;
}

const {
  title,
  description = iglesia.descripcionBreve,
  ogImage = '/og-default.png',
  noindex = false,
  schema,
  preloadImage,
} = Astro.props;

const siteName = iglesia.nombreCompleto;
const fullTitle = title === siteName ? title : `${title} · ${iglesia.nombreMarca}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url).href;

const site = Astro.site ?? Astro.url;
const { ubicacion, contacto, redes } = iglesia;
const churchSchema = {
  '@context': 'https://schema.org',
  '@type': 'Church',
  '@id': new URL('/#iglesia', site).href,
  name: siteName,
  alternateName: iglesia.nombreMarca,
  url: new URL('/', site).href,
  logo: new URL('/favicon-512.png', site).href,
  image: new URL('/og-default.png', site).href,
  description: iglesia.descripcionBreve,
  email: contacto.email,
  telephone: contacto.whatsapp,
  address: {
    '@type': 'PostalAddress',
    streetAddress: ubicacion.calle,
    addressLocality: ubicacion.ciudad,
    addressRegion: ubicacion.provincia,
    postalCode: ubicacion.codigoPostal,
    addressCountry: 'AR',
  },
  geo: { '@type': 'GeoCoordinates', latitude: ubicacion.lat, longitude: ubicacion.lng },
  ...(ubicacion.mapsUrl ? { hasMap: ubicacion.mapsUrl } : {}),
  sameAs: Object.values(redes).filter(Boolean),
};
const jsonLd = schema ? [churchSchema, schema] : churchSchema;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>

    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#4A2E17" />
    <meta name="google-site-verification" content="UPeP6C1_GFt5SuAO6eVi3NxuuSLxevEJabGQa0XZhsg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    {ogImage === '/og-default.png' && <meta property="og:image:width" content="1200" />}
    {ogImage === '/og-default.png' && <meta property="og:image:height" content="630" />}
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
